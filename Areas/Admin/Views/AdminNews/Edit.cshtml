@model WebGiaoDucGioiTinh.Models.FeaturedNews

<div class="container mx-auto max-w-2xl px-4 py-8 text-slate-800" style="margin-top: 100px; font-family: 'Segoe UI', sans-serif;">
    <div class="mb-6">
        <h1 class="text-2xl font-bold text-slate-800">✏️ Chỉnh sửa bản tin</h1>
        <p class="text-sm text-slate-500 mt-1">Thay đổi nội dung bản tin số #@Model.Id</p>
    </div>

    <form asp-action="Edit" method="post" class="space-y-5 bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
        <input type="hidden" asp-for="Id" />

        <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-2">Tiêu đề bài viết</label>
            <input asp-for="Title" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:border-pink-400 text-sm" required />
        </div>

        <div class="grid grid-cols-2 gap-4">
            <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-2">Chuyên mục (Tag)</label>
                <input asp-for="Tag" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:border-pink-400 text-sm" required />
            </div>
            <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-2">Link ảnh đại diện</label>
                <input asp-for="Img" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:border-pink-400 text-sm" required />
            </div>
        </div>

        <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-2">Mô tả ngắn gọn (Hiện ở trang chủ)</label>
            <textarea asp-for="Desc" rows="2" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:border-pink-400 text-sm" required></textarea>
        </div>

        <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-2">Nội dung chi tiết bài viết</label>
            <textarea asp-for="Content" rows="6" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:border-pink-400 text-sm" required></textarea>
        </div>

        <div class="flex items-center justify-between pt-4 border-t border-slate-100">
            <a asp-action="Index" class="text-sm text-slate-500 hover:text-slate-800 transition-colors">Hủy bỏ</a>
            <button type="submit" class="px-6 py-3 bg-pink-500 text-white font-bold rounded-xl hover:bg-pink-600 transition-all shadow-md shadow-pink-500/20 text-sm">
                💾 Lưu thay đổi
            </button>
        </div>
    </form>
</div>