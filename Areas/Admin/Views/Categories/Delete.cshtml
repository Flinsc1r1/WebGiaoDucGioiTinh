@model Category
@{
    ViewData["Title"] = "Xóa danh mục";
    var lessonCount = (int)(ViewBag.LessonCount ?? 0);
}

<div class="max-w-lg rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <p class="text-sm text-slate-600">Bạn có chắc muốn xóa danh mục sau?</p>
    <p class="mt-2 text-lg font-semibold text-slate-900">@Model.Name</p>
    @if (lessonCount > 0)
    {
        <p class="mt-3 rounded-lg bg-amber-50 px-3 py-2 text-sm text-amber-900">Danh mục đang có <strong>@lessonCount</strong> bài học — không thể xóa cho đến khi xử lý các bài đó.</p>
        <div class="mt-4">
            <a asp-action="Index" class="rounded-lg bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-800">Quay lại</a>
        </div>
    }
    else
    {
        <form asp-action="Delete" method="post" class="mt-6">
            <input type="hidden" asp-for="Id" />
            <div class="flex gap-2">
                <button type="submit" class="rounded-lg bg-red-600 px-4 py-2 text-sm font-medium text-white hover:bg-red-700">Xóa vĩnh viễn</button>
                <a asp-action="Index" class="rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">Hủy</a>
            </div>
        </form>
    }
</div>
