@model IReadOnlyList<AnonymousQuestion>
@{
    ViewData["Title"] = "Hộp thư thầm kín";
}

<div class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <p class="text-sm text-slate-600">@Model.Count câu hỏi ẩn danh</p>
    <a asp-area="" asp-controller="SecretMailbox" asp-action="Index" target="_blank" rel="noopener noreferrer" class="text-sm font-medium text-teal-700 underline-offset-4 hover:underline">Mở trang gửi câu hỏi ↗</a>
</div>

<div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
    <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-slate-200 text-sm">
            <thead class="bg-slate-50">
                <tr>
                    <th scope="col" class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-600">Id</th>
                    <th scope="col" class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-600">Nội dung</th>
                    <th scope="col" class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-600">Gửi lúc (UTC)</th>
                    <th scope="col" class="px-4 py-3 text-center text-xs font-semibold uppercase tracking-wide text-slate-600">Đã trả lời?</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 bg-white">
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="4" class="px-4 py-8 text-center text-slate-500">Chưa có câu hỏi nào.</td>
                    </tr>
                }
                else
                {
                    @foreach (var q in Model)
                    {
                        <tr class="align-top hover:bg-slate-50/80">
                            <td class="whitespace-nowrap px-4 py-3 font-mono text-slate-600">@q.Id</td>
                            <td class="max-w-xl px-4 py-3 text-slate-900">
                                <div class="font-medium">@q.Content</div>
    
                                @if (q.IsAnswered)
                                {
                                    <div class="mt-2 rounded-lg bg-emerald-50 p-2 text-sm text-emerald-800 border border-emerald-100">
                                        <strong>Trả lời:</strong> @q.AnswerContent
                                    </div>
                                }
                                else
                                {
                                    <form asp-action="Reply" method="post" class="mt-3 flex gap-2">
                                        <input type="hidden" name="id" value="@q.Id" />
                                        <input type="text" name="answerContent" placeholder="Nhập câu trả lời..."
                                               class="w-full rounded-md border-slate-300 shadow-sm focus:border-teal-500 focus:ring-teal-500 text-sm" required />
                                        <button type="submit" class="inline-flex items-center rounded-md bg-teal-600 px-3 py-1 text-xs font-semibold text-white hover:bg-teal-700">
                                            Gửi
                                        </button>
                                    </form>
                                }
                            </td>
                            <td class="whitespace-nowrap px-4 py-3 text-slate-600">@q.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="px-4 py-3 text-center">
                                @if (q.IsAnswered)
                                {
                                    <span class="inline-flex rounded-full bg-emerald-100 px-2.5 py-0.5 text-xs font-semibold text-emerald-800">Rồi</span>
                                }
                                else
                                {
                                    <span class="inline-flex rounded-full bg-amber-100 px-2.5 py-0.5 text-xs font-semibold text-amber-900">Chưa</span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
