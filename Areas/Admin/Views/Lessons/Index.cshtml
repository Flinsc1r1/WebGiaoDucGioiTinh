@model IReadOnlyList<LessonIndexRow>
@{
    ViewData["Title"] = "Bài học";
}

<div class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <p class="text-sm text-slate-600">@Model.Count bài học</p>
    <a asp-action="Create" class="inline-flex items-center justify-center rounded-lg bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-800">+ Thêm bài học</a>
</div>

<div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
    <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-slate-200 text-sm">
            <thead class="bg-slate-50">
                <tr>
                    <th scope="col" class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-600">Id</th>
                    <th scope="col" class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-600">Tiêu đề</th>
                    <th scope="col" class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-600">Danh mục</th>
                    <th scope="col" class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wide text-slate-600">Quiz</th>
                    <th scope="col" class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wide text-slate-600">Thao tác</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 bg-white">
                @foreach (var row in Model)
                {
                    <tr class="hover:bg-slate-50/80">
                        <td class="whitespace-nowrap px-4 py-3 font-mono text-slate-600">@row.Id</td>
                        <td class="max-w-xs px-4 py-3 font-medium text-slate-900">@row.Title</td>
                        <td class="whitespace-nowrap px-4 py-3 text-slate-600">@row.CategoryName</td>
                        <td class="whitespace-nowrap px-4 py-3 text-right text-slate-600">@row.QuizCount</td>
                        <td class="whitespace-nowrap px-4 py-3 text-right">
                            <a asp-action="Edit" asp-route-id="@row.Id" class="font-medium text-teal-700 hover:underline">Sửa</a>
                            <span class="mx-2 text-slate-300">|</span>
                            <a asp-action="Delete" asp-route-id="@row.Id" class="font-medium text-red-600 hover:underline">Xóa</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
