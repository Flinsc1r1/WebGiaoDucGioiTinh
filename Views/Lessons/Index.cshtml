@model IReadOnlyList<Category>
@{
    ViewData["Title"] = "Bài học";
}

<div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <header class="mb-10 text-center sm:text-left">
        <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Danh sách bài học</h1>
        <p class="mt-3 max-w-2xl text-base text-slate-600 sm:text-lg">
            Chọn danh mục và bài học phù hợp. Mỗi bài gồm nội dung và video minh họa; sau khi học bạn có thể ôn luyện bằng quiz.
        </p>
    </header>

    @if (Model.Count == 0)
    {
        <div class="rounded-2xl border border-white/50 bg-white/40 p-8 text-center text-slate-600 shadow-glass backdrop-blur-md">
            Chưa có bài học nào. Hãy chạy seed dữ liệu hoặc thêm bài trong cơ sở dữ liệu.
        </div>
    }
    else
    {
        @foreach (var category in Model)
        {
            <section class="mb-12" aria-labelledby="cat-@category.Id">
                <h2 id="cat-@category.Id" class="mb-4 flex items-center gap-2 text-xl font-semibold text-teal-900 sm:text-2xl">
                    <span class="h-2 w-2 rounded-full bg-emerald-500" aria-hidden="true"></span>
                    @category.Name
                </h2>
                <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
                    @foreach (var lesson in category.Lessons)
                    {
                        <article class="group flex flex-col overflow-hidden rounded-2xl border border-white/50 bg-white/45 shadow-glass backdrop-blur-md transition hover:border-sky-200/80 hover:shadow-lg">
                            <div class="relative aspect-[16/10] overflow-hidden bg-gradient-to-br from-mint to-soft-blue">
                                
                                <!-- ĐÃ SỬA: Tự động nhận diện ImageUrl dán từ Google, nếu không có mới lấy ảnh Picsum ngẫu nhiên -->
                                <img src="@(string.IsNullOrEmpty(lesson.ImageUrl) ? $"https://picsum.photos/seed/giaoduc-{lesson.Id}/800/500" : lesson.ImageUrl)"
                                     alt="@lesson.Title"
                                     class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
                                     width="800"
                                     height="500"
                                     loading="lazy" />
                                
                                <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-slate-900/35 to-transparent" aria-hidden="true"></div>
                                <span class="absolute bottom-3 left-3 rounded-full bg-white/90 px-2.5 py-0.5 text-xs font-medium text-teal-900 shadow-sm backdrop-blur-sm">
                                    @category.Name
                                </span>
                            </div>
                            <div class="flex flex-1 flex-col p-5">
                                <h3 class="text-lg font-semibold leading-snug text-slate-900 line-clamp-2">@lesson.Title</h3>
                                <p class="mt-2 flex-1 text-sm text-slate-600 line-clamp-2">
                                    Nội dung HTML — xem chi tiết để đọc đầy đủ và xem video.
                                </p>
                                <a asp-action="Details" asp-route-id="@lesson.Id"
                                   class="mt-4 inline-flex items-center justify-center rounded-xl bg-sunny px-4 py-2.5 text-sm font-semibold text-amber-950 shadow-sm ring-1 ring-amber-200/80 transition hover:bg-sunny-hover hover:shadow-md focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-400 focus-visible:ring-offset-2">
                                    Bắt đầu học
                                </a>
                            </div>
                        </article>
                    }
                </div>
            </section>
        }
    }
</div>