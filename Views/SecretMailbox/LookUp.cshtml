@model WebGiaoDucGioiTinh.Models.AnonymousQuestion

@{
    ViewData["Title"] = "Tra cứu câu trả lời";
}

<div class="min-h-[80vh] flex items-center justify-center px-4 py-12">
    <div class="mx-auto w-full max-w-5xl overflow-hidden rounded-3xl border border-white/40 bg-white/30 shadow-glass backdrop-blur-2xl sm:flex">

        <div class="relative flex flex-col justify-center bg-gradient-to-br from-teal-600/90 to-emerald-700/90 p-8 text-white sm:w-2/5 md:p-12">
            <div class="relative z-10">
                <span class="mb-4 inline-block rounded-full bg-white/20 px-3 py-1 text-xs font-semibold tracking-wider">THÔNG BÁO</span>
                <h2 class="mb-6 text-3xl font-bold leading-tight">Hộp thư thầm kín của bạn</h2>
                <ul class="space-y-4 text-sm text-emerald-50 opacity-90">
                    <li class="flex items-start gap-3">
                        <span class="mt-1 text-sunny">✦</span>
                        <p>Mã định danh giúp bạn tra cứu câu trả lời mà không cần đăng ký tài khoản.</p>
                    </li>
                    <li class="flex items-start gap-3">
                        <span class="mt-1 text-sunny">✦</span>
                        <p>Admin sẽ phản hồi câu hỏi của bạn trong vòng 24h - 48h làm việc.</p>
                    </li>
                    <li class="flex items-start gap-3">
                        <span class="mt-1 text-sunny">✦</span>
                        <p>Tin nhắn và mã tra cứu sẽ tự động được làm sạch sau 30 ngày để đảm bảo tính riêng tư.</p>
                    </li>
                </ul>
            </div>
            <div class="absolute -bottom-10 -left-10 h-40 w-40 rounded-full bg-white/10 blur-3xl"></div>
        </div>

        <div class="flex flex-col justify-center p-8 sm:w-3/5 md:p-12 bg-white/20">
            <h3 class="mb-2 text-xl font-bold text-slate-800">Kiểm tra kết quả</h3>
            <p class="mb-8 text-sm text-slate-500">Nhập mã bí mật (ví dụ: RGJ8u) để xem phản hồi từ đội ngũ chuyên gia.</p>

            <form asp-action="LookUp" method="get" class="relative mb-10">
                <div class="group relative transition-all">
                    <input type="text" name="qcode"
                           placeholder="Nhập mã bí mật của bạn..."
                           value="@Context.Request.Query["qcode"]"
                           class="w-full rounded-2xl border border-white/60 bg-white/40 py-4 pl-6 pr-16 text-slate-800 shadow-inner outline-none backdrop-blur-sm transition-all focus:border-teal-400 focus:bg-white/60 focus:ring-4 focus:ring-teal-500/10" />
                    <button type="submit" class="absolute right-2 top-2 rounded-xl bg-teal-600 px-5 py-2.5 font-bold text-white shadow-lg transition-all hover:bg-teal-700 hover:scale-105 active:scale-95">
                        Tìm
                    </button>
                </div>
                @if (ViewBag.Error != null)
                {
                    <p class="mt-3 text-xs font-medium text-red-500 flex items-center gap-1">
                        <span class="text-lg">⚠</span> @ViewBag.Error
                    </p>
                }
            </form>

            <div class="min-h-[150px]">
                @if (Model != null)
                {
                    <div class="rounded-2xl border border-teal-100 bg-teal-50/50 p-6 animate-in fade-in slide-in-from-bottom-4 duration-500">
                        <div class="mb-4">
                            <span class="text-[10px] font-bold uppercase tracking-widest text-teal-600">Nội dung bạn gửi:</span>
                            <p class="mt-1 text-sm italic text-slate-600">"@Model.Content"</p>
                        </div>
                        <div class="rounded-xl bg-white p-4 shadow-sm ring-1 ring-teal-100">
                            <span class="text-[10px] font-bold uppercase tracking-widest text-slate-400">Phản hồi từ Admin:</span>
                            <p class="mt-2 text-sm leading-relaxed text-slate-800">
                                @if (Model.IsAnswered)
                                {
                                    <span class="text-teal-700 font-medium">@Model.AnswerContent</span>
                                }
                                else
                                {
                                    <span class="flex items-center gap-2 text-amber-600 italic">
                                        <svg class="h-4 w-4 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                                        Hệ thống đã nhận được câu hỏi. Đang chờ chuyên gia trả lời...
                                    </span>
                                }
                            </p>
                        </div>
                    </div>
                }
                else if (string.IsNullOrEmpty(Context.Request.Query["qcode"]))
                {
                    <div id="local-history-section" class="hidden">
                        <h4 class="mb-3 text-xs font-bold uppercase tracking-wider text-slate-400">Mã câu hỏi đã gửi trên máy này:</h4>
                        <div id="history-list" class="flex flex-wrap gap-2"></div>
                    </div>

                    <div id="no-history-placeholder" class="flex h-full flex-col items-center justify-center text-center opacity-40">
                        <div class="mb-2 text-4xl">🔍</div>
                        <p class="text-xs font-medium uppercase tracking-tighter text-slate-400">Vui lòng nhập mã để xem kết quả</p>
                    </div>

                    <script>
                        document.addEventListener("DOMContentLoaded", function () {
                            let history = JSON.parse(localStorage.getItem('anonymous_mailbox_history')) || [];
                            if (history.length > 0) {
                                document.getElementById('no-history-placeholder').classList.add('hidden');
                                document.getElementById('local-history-section').classList.remove('hidden');
                                
                                let listContainer = document.getElementById('history-list');
                                history.forEach(code => {
                                    let btn = document.createElement('a');
                                    btn.href = `?qcode=${code}`;
                                    btn.className = "inline-flex items-center justify-center rounded-xl border border-teal-200 bg-white px-4 py-2 text-sm font-mono font-bold text-teal-700 shadow-sm transition hover:bg-teal-50 hover:scale-105";
                                    btn.innerText = `🔑 ${code}`;
                                    listContainer.appendChild(btn);
                                });
                            }
                        });
                    </script>
                }
            </div>
        </div>
    </div>
</div>