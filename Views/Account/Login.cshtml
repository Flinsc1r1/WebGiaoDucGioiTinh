@model LoginViewModel
@{ ViewData["Title"] = "Đăng nhập"; }

<div class="flex min-h-[60vh] items-center justify-center px-4" data-aos="zoom-in">
    <div class="w-full max-w-md rounded-[2rem] border border-white/50 bg-white/40 p-8 shadow-glass backdrop-blur-xl">
        <h2 class="mb-6 text-center text-3xl font-bold text-teal-900">Chào mừng trở lại!</h2>
        <form asp-action="Login" method="post" class="space-y-4">
            <div asp-validation-summary="ModelOnly" class="text-sm text-red-500"></div>
            <div>
                <label class="block text-sm font-medium text-slate-700">Email</label>
                <input asp-for="Email" class="mt-1 w-full rounded-xl border-white/60 bg-white/50 px-4 py-3 focus:ring-2 focus:ring-mint" />
            </div>
            <div>
                <label class="block text-sm font-medium text-slate-700">Mật khẩu</label>
                <input asp-for="Password" type="password" class="mt-1 w-full rounded-xl border-white/60 bg-white/50 px-4 py-3 focus:ring-2 focus:ring-mint" />
            </div>
            <button type="submit" class="w-full rounded-xl bg-sunny py-3.5 font-bold text-amber-950 shadow-sm transition hover:bg-sunny-hover">Đăng nhập</button>
        </form>
        <p class="mt-6 text-center text-sm text-slate-600">
            Chưa có tài khoản? <a asp-action="Register" class="font-bold text-teal-800 underline">Đăng ký ngay</a>
        </p>
    </div>
</div>