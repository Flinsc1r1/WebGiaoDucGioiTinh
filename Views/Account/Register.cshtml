@model RegisterViewModel
@{ ViewData["Title"] = "Đăng ký thành viên"; }

<div class="flex min-h-[70vh] items-center justify-center px-4" data-aos="fade-up">
    <div class="w-full max-w-md rounded-[2rem] border border-white/50 bg-white/40 p-8 shadow-glass backdrop-blur-xl">
        <h2 class="mb-6 text-center text-3xl font-bold text-teal-900">Tạo tài khoản mới</h2>
        <form asp-action="Register" method="post" class="space-y-4">
            <div asp-validation-summary="All" class="text-xs text-red-500 italic"></div>
            
            <div>
                <label class="block text-sm font-medium text-slate-700">Họ và tên</label>
                <input asp-for="FullName" class="mt-1 w-full rounded-xl border-none bg-white/50 px-4 py-3 ring-1 ring-white/60 focus:ring-2 focus:ring-mint" placeholder="Ghi họ tên vào đây" />
            </div>

            <div>
                <label class="block text-sm font-medium text-slate-700">Email</label>
                <input asp-for="Email" class="mt-1 w-full rounded-xl border-none bg-white/50 px-4 py-3 ring-1 ring-white/60 focus:ring-2 focus:ring-mint" />
            </div>

            <div>
                <label class="block text-sm font-medium text-slate-700">Mật khẩu</label>
                <input asp-for="Password" class="mt-1 w-full rounded-xl border-none bg-white/50 px-4 py-3 ring-1 ring-white/60 focus:ring-2 focus:ring-mint" />
            </div>

            <div>
                <label class="block text-sm font-medium text-slate-700">Xác nhận mật khẩu</label>
                <input asp-for="ConfirmPassword" class="mt-1 w-full rounded-xl border-none bg-white/50 px-4 py-3 ring-1 ring-white/60 focus:ring-2 focus:ring-mint" />
            </div>

            <button type="submit" class="mt-2 w-full rounded-xl bg-sunny py-3.5 font-bold text-amber-950 shadow-sm transition hover:bg-sunny-hover hover:scale-[1.02]">Đăng ký ngay</button>
        </form>
    </div>
</div>