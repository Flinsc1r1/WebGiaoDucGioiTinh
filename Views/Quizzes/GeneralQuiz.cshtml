@using Microsoft.AspNetCore.Identity
@using WebGiaoDucGioiTinh.Models
@inject UserManager<ApplicationUser> UserManager

@{
    ViewData["Title"] = "Đấu Trường Trí Tuệ - PK Leo Rank";

    // Đọc dữ liệu thô an toàn ở tầng Server trước khi đi vào mã kịch bản JavaScript
    var currentUser = User.Identity.IsAuthenticated ? UserManager.GetUserAsync(User).Result : null;
    var dbRankName = currentUser?.CurrentRank ?? "Đồng V";
    var dbStars = currentUser?.CurrentStars ?? 0;
}

<div class="container py-5 position-relative">
    <div id="confetti-wrapper"></div>

    <div class="text-center mb-5 animate-fade-down">
        <div class="d-inline-flex align-items-center gap-2 p-2 px-4 rounded-pill bg-soft-primary text-primary fw-extrabold small mb-3 tracking-wider bubble-badge">
            <span class="ping-container"><span class="ping-dot"></span></span> ⚡ CHẾ ĐỘ CHƠI: MINI GAME ⚡
        </div>
        <h1 class="fw-black text-gradient-play mb-2 tracking-tight">⚔️ ĐẤU TRƯỜNG RANK ⚔️</h1>
        <p class="text-muted fs-6 fw-medium">Hệ thống ghép trận  1v1 tự động • Thắng cộng 1 ⭐ • Thua trừ 1 ⭐</p>
        <div class="header-line-gradient mx-auto"></div>
    </div>

    <div class="row g-4">
        <div class="col-xl-8 col-lg-7">

            <div id="start-screen" class="card-peak text-center p-5 main-lobby-card animate-fade-in">
                <div class="lobby-bg-glow"></div>

                <div class="rank-profile-card-peak mx-auto mb-5 position-relative">
                    <div class="rank-sticker-container mb-3">
                        <img id="my-rank-badge" src="https://fonts.gstatic.com/s/e/notoemoji/latest/1f994/512.webp" alt="Rank" class="rank-sticker animate-jiggle" />
                    </div>

                    <div class="rank-text-badge mb-2" id="my-rank-box" style="padding: 6px 20px; font-weight: 900; border-radius: 12px; display: inline-block;">
                        <span class="fw-black fs-5" id="my-rank-name">@dbRankName</span>
                    </div>

                    <div class="stars-display-peak mb-3" id="my-stars"></div>
                    <span class="status-pill-peak text-success"><span class="dot-blink-peak"></span> Sẵn sàng chiến đấu</span>
                </div>

                <div class="mx-auto position-relative" style="max-width: 340px; z-index: 5;">
                    <button id="btn-find-match" class="btn btn-peak-gradient w-100 py-3 fw-black shadow-lg fs-5" onclick="toggleMatchmaking()">
                        ⚔️ TÌM TRẬN ĐẤU NGAY
                    </button>

                    <div id="matching-loader" class="text-center my-2 p-4 rounded-4 glass-panel border" style="display: none;">
                        <div class="cute-loading-avatar mb-3">
                            <img src="https://fonts.gstatic.com/s/e/notoemoji/latest/1f916/512.webp" alt="Searching..." class="animate-bounce" width="60">
                        </div>
                        <div class="text-dark fw-black small mb-1 tracking-wider">ĐANG QUÉT TÌM ĐỐI THỦ...</div>
                        <div class="progress progress-custom bg-light opacity-75 mb-3" style="height: 6px;">
                            <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary" style="width: 100%"></div>
                        </div>
                        <button class="btn btn-sm btn-danger-soft rounded-pill px-4 fw-bold" onclick="cancelMatchmaking()">Hủy tìm</button>
                    </div>
                </div>
            </div>

            <div id="game-screen" style="display: none;">
                <div class="card-peak p-4 game-arena-card">
                    <div class="row align-items-center mb-4 text-center g-3">
                        <div class="col-4 text-start">
                            <span class="badge bg-soft-primary text-primary fw-black px-3 py-2 mb-2 rounded-3">BẠN</span>
                            <div class="fs-1 fw-black text-primary lh-1 mb-1 animate-pulse" id="p1-score">0</div>
                            <div class="small text-muted fw-bold" id="p1-status">Đang suy nghĩ...</div>
                        </div>
                        <div class="col-4">
                            <div class="timer-circle-ultimate mx-auto mb-2">
                                <span id="lbl-timer">10</span><small>s</small>
                            </div>
                            <span class="badge bg-dark-soft text-dark rounded-pill px-3 py-1 small fw-black">Câu <span id="lbl-question-index">1</span>/30</span>
                        </div>
                        <div class="col-4 text-end">
                            <span class="badge bg-soft-danger text-danger fw-black px-3 py-2 mb-2 rounded-3">ĐỐI THỦ</span>
                            <div class="fs-1 fw-black text-danger lh-1 mb-1" id="p2-score">0</div>
                            <div class="small text-muted fw-bold" id="p2-status">Đang suy nghĩ...</div>
                        </div>
                    </div>
                    <div class="progress progress-custom mb-4 shadow-none bg-light" style="height: 10px;">
                        <div id="timer-progress" class="progress-bar bar-smooth" role="progressbar" style="width: 100%"></div>
                    </div>
                    <div class="question-container-peak p-4 mb-4 text-center shadow-sm">
                        <h4 id="question-content" class="mb-0 text-dark fw-black lh-base">Đang tải câu hỏi từ hệ thống...</h4>
                    </div>
                    <div class="row g-3" id="answer-container"></div>
                </div>
            </div>

            <div id="result-screen" style="display: none;">
                <div class="card-peak text-center p-5 d-flex flex-column align-items-center result-card-bg">
                    <div id="result-sticker" class="mb-3">
                        <img id="result-emoji-img" src="https://fonts.gstatic.com/s/e/notoemoji/latest/1f973/512.webp" alt="Result" class="animate-bounce" width="120">
                    </div>
                    <h2 id="result-title" class="fw-black text-success mb-1 tracking-tight fs-1">VICTORY</h2>
                    <p id="result-subtitle" class="text-muted mb-4 fw-bold">Tuyệt vời! Bạn đã tăng điểm xếp hạng thành công!</p>
                    <div class="score-display-box-peak mb-4 py-3 px-5 shadow-sm bg-white">
                        <span class="small text-secondary d-block fw-black mb-2 text-uppercase tracking-wider">KẾT QUẢ RANK TRẬN NÀY</span>
                        <div class="d-flex justify-content-center align-items-center gap-3">
                            <span id="rank-before" class="fw-bold text-muted fs-6">Đồng V (0⭐)</span>
                            <span class="text-warning fs-1 fw-black animate-jiggle" id="star-change-effect">+ 1 ⭐</span>
                            <span id="rank-after" class="fw-black text-success fs-5">Đang cập nhật...</span>
                        </div>
                    </div>
                    <button class="btn btn-peak-gradient px-5 py-3 border-0 mt-2 fs-6 shadow" onclick="backToLobby()">QUAY LẠI SẢNH CHỜ</button>
                </div>
            </div>

        </div>

        <div class="col-xl-4 col-lg-5">
            <div class="card-peak p-4 h-100 sidebar-leaderboard-card">
                <h5 class="fw-black mb-4 text-dark d-flex align-items-center justify-content-between">
                    <span><span class="fs-4 me-2">👑</span> TOP CAO THỦ SERVER</span>
                    <span class="badge bg-soft-primary text-primary font-monospace small px-2 py-1">LIVE</span>
                </h5>
                <div class="table-responsive">
                    <table class="table table-hover align-middle custom-leaderboard-table mb-0">
                        <thead>
                            <tr>
                                <th class="text-center" style="width: 20%;">Hạng</th>
                                <th>Kiện tướng</th>
                                <th>Danh hiệu</th>
                                <th class="text-end">Sao</th>
                            </tr>
                        </thead>
                        <tbody id="sidebar-leaderboard-body">
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted small">Đang kết nối dữ liệu máy chủ...</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

@section Scripts {
    <script>
        const RANK_CONFIGS = {
            "Đồng": { sticker: "https://fonts.gstatic.com/s/e/notoemoji/latest/1f994/512.webp", color: "#b45309", bg: "#fef3c7", maxStars: 5 },
            "Bạc": { sticker: "https://fonts.gstatic.com/s/e/notoemoji/latest/1f99a/512.webp", color: "#4b5563", bg: "#f3f4f6", maxStars: 5 },
            "Vàng": { sticker: "https://fonts.gstatic.com/s/e/notoemoji/latest/1f981/512.webp", color: "#d97706", bg: "#fef3c7", maxStars: 5 },
            "Bạch Kim": { sticker: "https://fonts.gstatic.com/s/e/notoemoji/latest/1f984/512.webp", color: "#0d9488", bg: "#ccfbf1", maxStars: 5 },
            "Kim Cương": { sticker: "https://fonts.gstatic.com/s/e/notoemoji/latest/1f30c/512.webp", color: "#2563eb", bg: "#dbeafe", maxStars: 5 },
            "Cao Thủ": { sticker: "https://fonts.gstatic.com/s/e/notoemoji/latest/1f42f/512.webp", color: "#7c3aed", bg: "#f3e8ff", maxStars: 99 },
            "Chiến Tướng": { sticker: "https://fonts.gstatic.com/s/e/notoemoji/latest/1f63c/512.webp", color: "#0f172a", bg: "#e2e8f0", maxStars: 999 },
            "Chiến Thần": { sticker: "https://fonts.gstatic.com/s/e/notoemoji/latest/1f409/512.webp", color: "#991b1b", bg: "#fee2e2", maxStars: 9999 }
        };

        // Gán dữ liệu sạch từ biến Razor đã xử lý từ trước
        let userCurrentRankName = "@Html.Raw(dbRankName)";
        let userCurrentStars = parseInt("@dbStars") || 0;

        let questions = [];
        let currentIndex = 0;
        let p1Score = 0;
        let timeLeft = 10;
        let timerInterval = null;
        let isAnswering = false;
        let isSearching = false;
        let matchTimer = null;

        // Hàm hiển thị giao diện thông tin Rank
        function initRankDisplay() {
            if (!userCurrentRankName || userCurrentRankName.trim() === "") {
                userCurrentRankName = "Đồng V";
            }

            let rankBase = "Đồng";
            for (const key in RANK_CONFIGS) {
                if (userCurrentRankName.toLowerCase().includes(key.toLowerCase())) {
                    rankBase = key;
                    break;
                }
            }

            const config = RANK_CONFIGS[rankBase];
            const badgeImg = document.getElementById("my-rank-badge");
            const rankNameText = document.getElementById("my-rank-name");
            const rankBox = document.getElementById("my-rank-box");

            if (badgeImg) badgeImg.src = config.sticker;
            if (rankNameText) rankNameText.innerText = userCurrentRankName;
            if (rankBox) {
                rankBox.style.color = config.color;
                rankBox.style.backgroundColor = config.bg;
            }

            const starsDisplay = document.getElementById("my-stars");
            if (starsDisplay) {
                let starsHtml = "";
                let maxStarsToShow = config.maxStars > 5 ? 5 : config.maxStars;

                for (let i = 1; i <= maxStarsToShow; i++) {
                    if (i <= userCurrentStars) {
                        starsHtml += `<i class="bi bi-star-fill text-warning me-1 fs-4 animate-pulse"></i>`;
                    } else {
                        starsHtml += `<i class="bi bi-star text-muted opacity-30 me-1 fs-4"></i>`;
                    }
                }
                if (config.maxStars > 5) {
                    starsHtml = `<i class="bi bi-star-fill text-warning me-1 fs-4"></i> <span class="fw-black text-warning fs-4">x${userCurrentStars}</span>`;
                }
                starsDisplay.innerHTML = starsHtml;
            }
        }

        // Tải bảng xếp hạng người chơi thật qua API
        async function loadLeaderboard() {
            try {
                const response = await fetch('/Quizzes/GetLeaderboard');
                if (!response.ok) return;
                const players = await response.json();

                const tbody = document.getElementById("sidebar-leaderboard-body");
                if (!tbody) return;

                if (players.length === 0) {
                    tbody.innerHTML = `<tr><td colspan="4" class="text-center py-3 text-muted">Chưa có bảng xếp hạng.</td></tr>`;
                    return;
                }

                let html = "";
                players.forEach((player, index) => {
                    let medal = index + 1;
                    if (index === 0) medal = "🥇";
                    else if (index === 1) medal = "🥈";
                    else if (index === 2) medal = "🥉";

                    let tagClass = "bg-light text-dark border";
                    if (player.rankName.includes("Chiến Thần")) tagClass = "bg-danger text-white fw-bold";
                    else if (player.rankName.includes("Chiến Tướng")) tagClass = "bg-dark text-white fw-bold";
                    else if (player.rankName.includes("Cao Thủ")) tagClass = "bg-warning text-dark fw-bold";

                    html += `
                        <tr>
                            <td class="text-center fw-black">${medal}</td>
                            <td class="fw-bold text-dark text-truncate" style="max-width: 110px;">${player.fullName}</td>
                            <td><span class="badge ${tagClass}" style="font-size:0.75rem;">${player.rankName}</span></td>
                            <td class="text-end fw-black text-warning">${player.stars} ⭐</td>
                        </tr>
                    `;
                });
                tbody.innerHTML = html;
            } catch (e) {
                console.error("Lỗi đồng bộ bảng xếp hạng:", e);
            }
        }

        document.addEventListener("DOMContentLoaded", function() {
            initRankDisplay();
            loadLeaderboard();
        });

        // --- CÁC HÀM VẬN HÀNH MINI GAME ---
        function toggleMatchmaking() {
            if (!isSearching) {
                isSearching = true;
                document.getElementById("btn-find-match").style.display = "none";
                document.getElementById("matching-loader").style.display = "block";
                matchTimer = setTimeout(() => { startPvPMatch(); }, 2000);
            }
        }

        function cancelMatchmaking() {
            isSearching = false;
            clearTimeout(matchTimer);
            document.getElementById("btn-find-match").style.display = "block";
            document.getElementById("matching-loader").style.display = "none";
        }

        async function startPvPMatch() {
            try {
                const response = await fetch('/Quizzes/GetRandomQuestions');
                questions = await response.json();
                if (!questions || questions.length === 0) {
                    alert("Không lấy được gói câu hỏi từ cơ sở dữ liệu.");
                    cancelMatchmaking();
                    return;
                }
                document.getElementById("start-screen").style.display = "none";
                document.getElementById("game-screen").style.display = "block";
                currentIndex = 0; p1Score = 0;
                document.getElementById("p1-score").innerText = p1Score;
                document.getElementById("p2-score").innerText = 0;
                loadQuestion();
            } catch (error) {
                alert("Lỗi kết nối API lấy câu hỏi!");
                cancelMatchmaking();
            }
        }

        function loadQuestion() {
            if(currentIndex >= questions.length || currentIndex >= 30) {
                endGame(p1Score >= 1500); return;
            }
            isAnswering = false; timeLeft = 10;
            document.getElementById("lbl-question-index").innerText = currentIndex + 1;
            document.getElementById("lbl-timer").innerText = timeLeft;
            document.getElementById("p1-status").className = "small text-muted fw-bold";
            document.getElementById("p1-status").innerText = "Đang suy nghĩ...";
            document.getElementById("p2-status").className = "small text-muted fw-bold";
            document.getElementById("p2-status").innerText = "Đang suy nghĩ...";
            const progressBar = document.getElementById("timer-progress");
            progressBar.style.width = "100%"; progressBar.style.backgroundColor = "#2563eb";

            const currentQ = questions[currentIndex];
            document.getElementById("question-content").innerText = currentQ.question;
            const container = document.getElementById("answer-container");
            container.innerHTML = `
                <div class="col-md-6"><button class="btn answer-btn-peak w-100 p-3" onclick="selectAnswer('A', this)"><span class="ans-letter-peak">A</span> ${currentQ.optionA}</button></div>
                <div class="col-md-6"><button class="btn answer-btn-peak w-100 p-3" onclick="selectAnswer('B', this)"><span class="ans-letter-peak">B</span> ${currentQ.optionB}</button></div>
                <div class="col-md-6"><button class="btn answer-btn-peak w-100 p-3" onclick="selectAnswer('C', this)"><span class="ans-letter-peak">C</span> ${currentQ.optionC}</button></div>
                <div class="col-md-6"><button class="btn answer-btn-peak w-100 p-3" onclick="selectAnswer('D', this)"><span class="ans-letter-peak">D</span> ${currentQ.optionD}</button></div>
            `;
            clearInterval(timerInterval);
            timerInterval = setInterval(countdown, 1000);
        }

        function countdown() {
            timeLeft--;
            document.getElementById("lbl-timer").innerText = timeLeft;
            document.getElementById("timer-progress").style.width = (timeLeft / 10) * 100 + "%";
            if (timeLeft <= 3) document.getElementById("timer-progress").style.backgroundColor = "#ef4444";
            if (timeLeft <= 0) {
                clearInterval(timerInterval); isAnswering = true;
                document.getElementById("p1-status").className = "small text-danger fw-black";
                document.getElementById("p1-status").innerText = "❌ Hết giờ!";
                setTimeout(() => { currentIndex++; loadQuestion(); }, 1200);
            }
        }

        async function selectAnswer(letter, btnElement) {
            if (isAnswering) return; isAnswering = true; clearInterval(timerInterval);
            const currentQ = questions[currentIndex];
            const allButtons = document.querySelectorAll('.answer-btn-peak');
            allButtons.forEach(b => b.disabled = true);
            try {
                const response = await fetch('/Quizzes/CheckAnswer', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ questionId: currentQ.id, selectedAnswer: letter })
                });
                const result = await response.json();
                if (result.isCorrect) {
                    p1Score += (timeLeft * 10) + 100;
                    document.getElementById("p1-score").innerText = p1Score;
                    btnElement.className = "btn answer-btn-peak status-correct-peak w-100 p-3 text-white fw-black animate-jiggle";
                    document.getElementById("p1-status").className = "small text-success fw-black";
                    document.getElementById("p1-status").innerText = "🎉 CHÍNH XÁC!";
                } else {
                    btnElement.className = "btn answer-btn-peak status-wrong-peak w-100 p-3 text-white fw-black";
                    document.getElementById("p1-status").className = "small text-danger fw-black";
                    document.getElementById("p1-status").innerText = "❌ SAI RỒI!";
                }
                setTimeout(() => {
                    document.getElementById("p2-score").innerText = parseInt(document.getElementById("p2-score").innerText) + 80;
                    document.getElementById("p2-status").className = "small text-warning fw-black";
                    document.getElementById("p2-status").innerText = "⚡ Đã chọn";
                    setTimeout(() => { currentIndex++; loadQuestion(); }, 1000);
                }, 400);
            } catch (error) {
                isAnswering = false; allButtons.forEach(b => b.disabled = false);
            }
        }

        async function endGame(isWin) {
            clearInterval(timerInterval);
            document.getElementById("game-screen").style.display = "none";
            document.getElementById("result-screen").style.display = "block";
            document.getElementById("rank-before").innerText = `${userCurrentRankName} (${userCurrentStars} ⭐)`;
            if (isWin) {
                document.getElementById("result-title").innerText = "VICTORY (CHIẾN THẮNG)";
                document.getElementById("result-title").className = "fw-black text-success mb-1 tracking-tight fs-1";
                document.getElementById("result-subtitle").innerText = "Tuyệt vời! Bạn đã tăng bậc điểm xếp hạng thành công!";
                document.getElementById("star-change-effect").innerText = "+ 1 ⭐";
                document.getElementById("star-change-effect").className = "text-warning fs-1 fw-black animate-jiggle";
                document.getElementById("result-emoji-img").src = "https://fonts.gstatic.com/s/e/notoemoji/latest/1f973/512.webp";
                createConfetti();
            } else {
                document.getElementById("result-title").innerText = "DEFEAT (THẤT BẠI)";
                document.getElementById("result-title").className = "fw-black text-danger mb-1 tracking-tight fs-1";
                document.getElementById("result-subtitle").innerText = "Rất tiếc, câu hỏi quá hiểm hóc! Hãy cố gắng ở trận sau nhé.";
                document.getElementById("star-change-effect").innerText = "- 1 ⭐";
                document.getElementById("star-change-effect").className = "text-danger fs-1 fw-black";
                document.getElementById("result-emoji-img").src = "https://fonts.gstatic.com/s/e/notoemoji/latest/1f614/512.webp";
            }
            try {
                const response = await fetch('/Quizzes/UpdateRankAfterMatch', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ isWin: isWin })
                });
                if (response.ok) {
                    const data = await response.json();
                    userCurrentRankName = data.newRank; userCurrentStars = data.newStars;
                    document.getElementById("rank-after").innerText = `${userCurrentRankName} (${userCurrentStars} Sao)`;
                } else {
                    document.getElementById("rank-after").innerText = "Lỗi đồng bộ Database!";
                }
            } catch (error) {
                document.getElementById("rank-after").innerText = "Mất kết nối mạng!";
            }
        }

        function backToLobby() {
            initRankDisplay(); loadLeaderboard();
            document.getElementById("confetti-wrapper").innerHTML = "";
            document.getElementById("result-screen").style.display = "none";
            document.getElementById("start-screen").style.display = "block";
            cancelMatchmaking();
        }

        function createConfetti() {
            const wrapper = document.getElementById("confetti-wrapper");
            for (let i = 0; i < 40; i++) {
                const confetti = document.createElement("div"); confetti.className = "confetti-piece";
                confetti.style.left = Math.random() * 100 + "vw"; confetti.style.animationDelay = Math.random() * 2 + "s";
                confetti.style.backgroundColor = ["#ffc107", "#ff4757", "#2ed573", "#1e90ff", "#a55eea"][Math.floor(Math.random() * 5)];
                wrapper.appendChild(confetti);
            }
        }
    </script>

    <style>
        body {
            background-color: #f7fafc;
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
        }

        .fw-black {
            font-weight: 900 !important;
        }

        .card-peak {
            background: #ffffff;
            border-radius: 32px;
            border: 2px solid #eef2f6;
            box-shadow: 0 20px 40px rgba(148, 163, 184, 0.08);
            position: relative;
            overflow: hidden;
        }

        .text-gradient-play {
            background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .header-line-gradient {
            width: 100px;
            height: 6px;
            background: linear-gradient(90deg, #3b82f6, #60a5fa, #3b82f6);
            border-radius: 50px;
        }

        .main-lobby-card {
            background: radial-gradient(circle at top right, #fcfdff, #ffffff);
        }

        .lobby-bg-glow {
            position: absolute;
            top: -100px;
            left: 50%;
            transform: translateX(-50%);
            width: 400px;
            height: 250px;
            background: radial-gradient(circle, rgba(59,130,246,0.06) 0%, transparent 70%);
            z-index: 1;
            pointer-events: none;
        }

        .rank-profile-card-peak {
            background: #ffffff;
            border: 2px solid #e2e8f0;
            border-radius: 28px;
            padding: 35px 25px;
            max-width: 330px;
            box-shadow: 0 12px 30px rgba(160, 175, 195, 0.06);
            z-index: 2;
        }

        .rank-sticker-container {
            display: flex;
            justify-content: center;
            align-items: center;
            width: 100%;
        }

        .rank-sticker {
            width: 110px;
            height: 110px;
            object-fit: contain;
            filter: drop-shadow(0 8px 12px rgba(0,0,0,0.05));
