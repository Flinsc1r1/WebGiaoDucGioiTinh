        }

        .dot-blink-peak {
            width: 8px;
            height: 8px;
            background-color: #22c55e;
            border-radius: 50%;
            display: inline-block;
            animation: pulse 1.5s infinite;
        }

        .btn-peak-gradient {
            background: linear-gradient(135deg, #3b82f6 0%, #2563eb 50%, #1d4ed8 100%);
            color: #fff;
            border: none;
            border-radius: 20px;
            padding: 18px;
            font-size: 1.1rem;
            transition: all 0.3s ease;
        }

            .btn-peak-gradient:hover {
                color: #fff;
                transform: translateY(-4px) scale(1.02);
                box-shadow: 0 15px 30px rgba(37, 99, 235, 0.3) !important;
            }

        .timer-circle-ultimate {
            width: 76px;
            height: 76px;
            border-radius: 50%;
            background: #ffffff;
            border: 4px solid #fecaca;
            color: #ef4444;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 900;
            font-size: 1.6rem;
            box-shadow: 0 6px 15px rgba(239, 68, 68, 0.05);
        }

            .timer-circle-ultimate small {
                font-size: 0.8rem;
                color: #94a3b8;
                margin-left: 1px;
            }

        .question-container-peak {
            background-color: #f8fafc;
            border-radius: 24px;
            border-bottom: 6px solid #3b82f6;
        }

        .answer-btn-peak {
            background-color: #ffffff;
            border: 2px solid #e2e8f0;
            border-radius: 20px;
            text-align: left;
            color: #334155;
            font-weight: 800;
            font-size: 1.05rem;
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        }

            .answer-btn-peak:hover:not(:disabled) {
                background-color: #f8fafc;
                border-color: #3b82f6;
                color: #1e40af;
                transform: translateY(-2px);
                box-shadow: 0 8px 20px rgba(37, 99, 235, 0.05);
            }

        .ans-letter-peak {
            background-color: #f1f5f9;
            color: #475569;
            padding: 6px 12px;
            border-radius: 12px;
            margin-right: 14px;
        }

        .status-correct-peak {
            background: #10b981 !important;
            border-color: #10b981 !important;
        }

        .status-wrong-peak {
            background: #ef4444 !important;
            border-color: #ef4444 !important;
        }

        .custom-leaderboard-table th {
            font-size: 0.75rem;
            color: #64748b;
            text-transform: uppercase;
            border-bottom: 2px solid #f1f5f9;
            padding-bottom: 14px;
            font-weight: 900;
        }

        .custom-leaderboard-table td {
